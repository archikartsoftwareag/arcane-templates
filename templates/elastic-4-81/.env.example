# Archikart Elastic 4.81 - Umgebungsvariablen
# "#" = Kommentarzeichen; nur Zeilen in der Form SCHLUESSEL=WERT werden ausgewertet.

# Elastic Passwort
# Passwort für die Authentifizierung mit Elastic. Wird auch bei der Anmeldung im AK4 Elastic Service benötigt.
# PFLICHTFELD - muss vor dem Deploy gesetzt werden!
ELASTIC_PASSWORD=

# Elasticsearch Netzwerk Port
# Über diesen Port ist der Elastic Service erreichbar. Default ist 9200.
ELASTIC_PORT=9200

# Logstash Netzwerk Port
# Über diesen Port ist der Logstash Service erreichbar. Default ist 9201.
LOGSTASH_PORT=9201

# Elastic JVM_MEMORY
# Bestimmt die Arbeitsspeichermenge in GByte der Elastic JVM, sollte mindestens 1 sein.
ELASTIC_JVM_MEMORY=1

# Elastic CONTAINER_MEMORY
# Bestimmt die maximale Arbeitsspeichermenge in GByte des Elastic Container, sollte mindestens ELASTIC_JVM_MEMORY + 1 sein.
ELASTIC_CONTAINER_MEMORY=2

# Logstash JVM_MEMORY
# Bestimmt die Arbeitsspeichermenge in GByte der Logstash JVM, sollte mindestens 2 sein.
LOGSTASH_JVM_MEMORY=2

# Cron Schedule
# Bestimmt die Zeit zu welcher das Elastic alle Daten Neu einliest.
CRON_SCHEDULE=0 2 * * *

# Netzwerk Name
# Name des internen Docker Netz. Nur Container im gleichen Netzwerk können miteinander kommunizieren.
NETWORK_NAME=archikartnet
