# Archikart ALKIS 4.80 - Umgebungsvariablen
# "#" = Kommentarzeichen; nur Zeilen in der Form SCHLUESSEL=WERT werden ausgewertet.

# Datastore Port
# Der Port für die Kommunikation mit dem Datastore. Ändern Sie ggf. den gesetzten default Port.
ALKIS_POSTGIS_PORT=5432

# ALKIS-Import Port
# Der Port für die Kommunikation mit der ALKIS Instanz. Ändern Sie ggf. den gesetzten default Port.
ALKIS_GID7_PORT=10722
