# Arcane – optionale Umgebungsvariablen
# (Portainer: Stack-Umgebungsvariablen, CLI: als .env neben compose.yaml)
# Es gibt keine Pflichtvariablen: ENCRYPTION_KEY und Admin-API-Key werden beim ersten Start erzeugt.

# Zugang zur Archikart Docker-Registry (siehe Handbuch). Leer = wird übersprungen,
# dann in Arcane unter Customization → Container Registries eintragen.
DOCKER_REGISTRY_USER=
DOCKER_REGISTRY_PASSWORD=

# Öffentliche URL der Arcane-Oberfläche
# APP_URL=http://dockerhost:3552

# Nur zur Übernahme einer bestehenden Installation: deren ENCRYPTION_KEY (64 Hex-Zeichen).
# Wirkt nur beim allerersten Start des Stacks, danach wird der Key aus dem Volume arcane-secrets verwendet.
# ENCRYPTION_KEY=

# Abweichende Template-Registry oder Docker-Registry
# TEMPLATE_REGISTRY_URL=https://raw.githubusercontent.com/archikartsoftwareag/arcane-templates/main/registry.json
# DOCKER_REGISTRY_URL=docker.archikart.de
